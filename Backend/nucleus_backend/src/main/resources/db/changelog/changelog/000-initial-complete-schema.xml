<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- ===== USERS TABLE ===== -->
    <changeSet id="000-1" author="dev">
        <createTable tableName="users">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(255)"/>
            <column name="role" type="VARCHAR(50)" defaultValue="DEVELOPER">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValue="true"/>
            <column name="last_login_at" type="TIMESTAMPTZ"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValue="now()"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValue="now()"/>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
        </createTable>
        <comment>Create users table with enhanced fields</comment>
    </changeSet>

    <!-- ===== ORGANIZATIONS TABLE ===== -->
    <changeSet id="000-2" author="dev">
        <createTable tableName="organizations">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(100)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValue="now()"/>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
        </createTable>
        <comment>Create organizations table for multi-tenant support</comment>
    </changeSet>

    <!-- ===== PROJECTS TABLE ===== -->
    <changeSet id="000-3" author="dev">
        <createTable tableName="projects">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="project_key" type="VARCHAR(10)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="organization_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="is_private" type="BOOLEAN" defaultValue="false"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValue="now()"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValue="now()"/>
            <column name="archived_at" type="TIMESTAMPTZ"/>
        </createTable>
        <comment>Create projects table with organization relationship</comment>
    </changeSet>

    <!-- ===== PROJECT MEMBERS TABLE ===== -->
    <changeSet id="000-4" author="dev">
        <createTable tableName="project_members">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)" defaultValue="VIEWER">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_at" type="TIMESTAMPTZ" defaultValue="now()"/>
        </createTable>
        <comment>Create project members table for role-based access</comment>
    </changeSet>

    <!-- ===== PROJECT SEQUENCES TABLE ===== -->
    <changeSet id="000-5" author="dev">
        <createTable tableName="project_sequences">
            <column name="project_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="next_issue_number" type="INT" defaultValue="1">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <comment>Create project sequences for issue key generation</comment>
    </changeSet>

    <!-- ===== ISSUES TABLE ===== -->
    <changeSet id="000-6" author="dev">
        <createTable tableName="issues">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="issue_key" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="type" type="VARCHAR(20)" defaultValue="TASK">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="VARCHAR(50)" defaultValue="MEDIUM">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="reporter_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="assignee_id" type="BIGINT"/>
            <column name="parent_issue_id" type="BIGINT"/>
            <column name="story_points" type="INTEGER"/>
            <column name="time_estimate" type="INTEGER"/>
            <column name="time_spent" type="INTEGER" defaultValue="0"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValue="now()"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValue="now()"/>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
        </createTable>
        <comment>Create issues table with enhanced fields</comment>
    </changeSet>

    <!-- ===== COMMENTS TABLE ===== -->
    <changeSet id="000-7" author="dev">
        <createTable tableName="comments">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="issue_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValue="now()"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValue="now()"/>
        </createTable>
        <comment>Create comments table</comment>
    </changeSet>

    <!-- ===== ATTACHMENTS TABLE ===== -->
    <changeSet id="000-8" author="dev">
        <createTable tableName="attachments">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(255)"/>
            <column name="file_url" type="VARCHAR(255)"/>
            <column name="file_size" type="BIGINT"/>
            <column name="issue_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_at" type="TIMESTAMPTZ" defaultValue="now()"/>
        </createTable>
        <comment>Create attachments table</comment>
    </changeSet>

    <!-- ===== AUDIT LOGS TABLE ===== -->
    <changeSet id="000-9" author="dev">
        <createTable tableName="audit_logs">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(100)"/>
            <column name="details" type="TEXT"/>
            <column name="user_id" type="BIGINT"/>
            <column name="timestamp" type="TIMESTAMPTZ" defaultValue="now()"/>
        </createTable>
        <comment>Create audit logs table</comment>
    </changeSet>

    <!-- ===== FOREIGN KEY CONSTRAINTS ===== -->
    <changeSet id="000-10" author="dev">
        <!-- Organizations foreign keys -->
        <addForeignKeyConstraint
                baseTableName="organizations"
                baseColumnNames="created_by"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_organizations_created_by"
                onDelete="RESTRICT"/>

        <!-- Projects foreign keys -->
        <addForeignKeyConstraint
                baseTableName="projects"
                baseColumnNames="organization_id"
                referencedTableName="organizations"
                referencedColumnNames="id"
                constraintName="fk_projects_organization"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="projects"
                baseColumnNames="owner_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_projects_owner"
                onDelete="RESTRICT"/>

        <!-- Project members foreign keys -->
        <addForeignKeyConstraint
                baseTableName="project_members"
                baseColumnNames="project_id"
                referencedTableName="projects"
                referencedColumnNames="id"
                constraintName="fk_project_members_project"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="project_members"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_project_members_user"
                onDelete="CASCADE"/>

        <!-- Project sequences foreign key -->
        <addForeignKeyConstraint
                baseTableName="project_sequences"
                baseColumnNames="project_id"
                referencedTableName="projects"
                referencedColumnNames="id"
                constraintName="fk_project_sequences_project"
                onDelete="CASCADE"/>

        <!-- Issues foreign keys -->
        <addForeignKeyConstraint
                baseTableName="issues"
                baseColumnNames="project_id"
                referencedTableName="projects"
                referencedColumnNames="id"
                constraintName="fk_issues_project"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="issues"
                baseColumnNames="reporter_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_issues_reporter"
                onDelete="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="issues"
                baseColumnNames="assignee_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_issues_assignee"
                onDelete="SET NULL"/>

        <addForeignKeyConstraint
                baseTableName="issues"
                baseColumnNames="parent_issue_id"
                referencedTableName="issues"
                referencedColumnNames="id"
                constraintName="fk_issues_parent"
                onDelete="CASCADE"/>

        <!-- Comments foreign keys -->
        <addForeignKeyConstraint
                baseTableName="comments"
                baseColumnNames="issue_id"
                referencedTableName="issues"
                referencedColumnNames="id"
                constraintName="fk_comments_issue"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="comments"
                baseColumnNames="author_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_comments_author"
                onDelete="RESTRICT"/>

        <!-- Attachments foreign keys -->
        <addForeignKeyConstraint
                baseTableName="attachments"
                baseColumnNames="issue_id"
                referencedTableName="issues"
                referencedColumnNames="id"
                constraintName="fk_attachments_issue"
                onDelete="CASCADE"/>

        <!-- Audit logs foreign keys -->
        <addForeignKeyConstraint
                baseTableName="audit_logs"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_audit_logs_user"
                onDelete="SET NULL"/>

        <comment>Add all foreign key constraints</comment>
    </changeSet>

    <!-- ===== INDEXES FOR PERFORMANCE ===== -->
    <changeSet id="000-11" author="dev">
        <!-- Users indexes -->
        <createIndex tableName="users" indexName="idx_users_username">
            <column name="username"/>
        </createIndex>
        <createIndex tableName="users" indexName="idx_users_email">
            <column name="email"/>
        </createIndex>
        <createIndex tableName="users" indexName="idx_users_active">
            <column name="is_active"/>
        </createIndex>

        <!-- Organizations indexes -->
        <createIndex tableName="organizations" indexName="idx_organizations_slug">
            <column name="slug"/>
        </createIndex>
        <createIndex tableName="organizations" indexName="idx_organizations_created_by">
            <column name="created_by"/>
        </createIndex>

        <!-- Projects indexes -->
        <createIndex tableName="projects" indexName="idx_projects_key">
            <column name="project_key"/>
        </createIndex>
        <createIndex tableName="projects" indexName="idx_projects_organization">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="projects" indexName="idx_projects_owner">
            <column name="owner_id"/>
        </createIndex>
        <createIndex tableName="projects" indexName="idx_projects_archived">
            <column name="archived_at"/>
        </createIndex>

        <!-- Project members indexes -->
        <createIndex tableName="project_members" indexName="idx_project_members_user">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="project_members" indexName="idx_project_members_project">
            <column name="project_id"/>
        </createIndex>
        <createIndex tableName="project_members" indexName="idx_project_members_role">
            <column name="role"/>
        </createIndex>

        <!-- Issues indexes -->
        <createIndex tableName="issues" indexName="idx_issues_key">
            <column name="issue_key"/>
        </createIndex>
        <createIndex tableName="issues" indexName="idx_issues_project_status">
            <column name="project_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="issues" indexName="idx_issues_assignee">
            <column name="assignee_id"/>
        </createIndex>
        <createIndex tableName="issues" indexName="idx_issues_reporter">
            <column name="reporter_id"/>
        </createIndex>
        <createIndex tableName="issues" indexName="idx_issues_parent">
            <column name="parent_issue_id"/>
        </createIndex>
        <createIndex tableName="issues" indexName="idx_issues_type">
            <column name="type"/>
        </createIndex>
        <createIndex tableName="issues" indexName="idx_issues_priority">
            <column name="priority"/>
        </createIndex>

        <!-- Comments indexes -->
        <createIndex tableName="comments" indexName="idx_comments_issue">
            <column name="issue_id"/>
        </createIndex>
        <createIndex tableName="comments" indexName="idx_comments_author">
            <column name="author_id"/>
        </createIndex>
        <createIndex tableName="comments" indexName="idx_comments_created">
            <column name="created_at"/>
        </createIndex>

        <!-- Attachments indexes -->
        <createIndex tableName="attachments" indexName="idx_attachments_issue">
            <column name="issue_id"/>
        </createIndex>

        <!-- Audit logs indexes -->
        <createIndex tableName="audit_logs" indexName="idx_audit_logs_user">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="audit_logs" indexName="idx_audit_logs_timestamp">
            <column name="timestamp"/>
        </createIndex>

        <comment>Add performance indexes</comment>
    </changeSet>

    <!-- ===== INITIAL DATA ===== -->
